{
  "ConnectionStrings": {
    "RaceDayConnection": "Server=(localdb)\\MSSQLLocalDB;Database=RaceDayDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "EventBannerContainer": "event-banners",
    "ProfilePictureContainer": "profile-pictures",
    "PublicBaseUrl": "",
    "AllowPublicRead": true
  },
  "SeedDemoData": false,
  "UseHttpsRedirection": false,
  "Swagger": {
    "Enabled": false
  },
  "Database": {
    "StartupRetryCount": 12,
    "StartupRetryDelaySeconds": 5
  }
}