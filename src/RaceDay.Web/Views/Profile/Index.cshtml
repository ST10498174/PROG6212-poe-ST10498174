@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    var initials = $"{Model.FirstName.FirstOrDefault()}{Model.LastName.FirstOrDefault()}".ToUpperInvariant();
}
<div class="page-head">
    <h1>Your profile</h1>
    <p class="lead mb-0">These details are shared with organisers of the events you enter.</p>
    <div class="lane-line"></div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="panel panel-pad text-center">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img id="avatarPreview" class="avatar avatar-lg" src="@Model.ProfilePictureUrl" alt="Your profile picture" />
            }
            else
            {
                <img id="avatarPreview" class="avatar avatar-lg d-none" alt="" />
                <span class="avatar avatar-lg" id="avatarInitials" aria-hidden="true">@initials</span>
            }
            <h2 class="h3 mt-3 mb-1">@Model.FirstName @Model.LastName</h2>
            <span class="role-chip">@Model.Role</span>

            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="mt-4 text-start">
                <label for="picture" class="form-label">Profile picture</label>
                <input id="picture" name="picture" type="file" class="form-control" accept="@ImageUploadRules.AcceptAttribute" required data-preview="avatarPreview"
                       onchange="document.getElementById('avatarPreview').classList.remove('d-none'); var i=document.getElementById('avatarInitials'); if(i) i.remove();" />
                <div class="form-text">JPG, PNG, WebP or GIF up to 5 MB. Stored securely in RaceDay's cloud storage.</div>
                <button type="submit" class="btn btn-outline-primary w-100 mt-3" data-busy="Uploading…"><i class="bi bi-upload me-1"></i>Upload picture</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <form asp-action="Index" method="post" class="form-panel" novalidate>
            <div class="form-section-title">Personal details</div>
            <div asp-validation-summary="ModelOnly" class="rd-alert rd-alert-error d-block" role="alert"></div>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DateOfBirth"></span>
                </div>
            </div>
            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-primary">Save profile</button>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
