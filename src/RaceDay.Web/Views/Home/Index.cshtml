@model List<EventDto>
@{
    ViewData["Title"] = "Road events across South Africa";
    ViewData["FullBleed"] = true;
}

<section class="hero">
    <div class="container hero-inner">
        <div class="row align-items-end g-4">
            <div class="col-lg-7">
                <h1>Every road race, walk and ride. One start line.</h1>
                <p class="lead mt-3">RaceDay brings South Africa's park runs, charity walks, half marathons and cycle tours into one place. Find an event, pick your category and enter in under a minute.</p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a class="btn btn-lane btn-lg" asp-controller="Events" asp-action="Index">Browse upcoming events</a>
                    <a class="btn btn-outline-light-subtle btn-lg" asp-controller="Account" asp-action="Register" asp-route-role="Organiser">Organise an event</a>
                </div>
            </div>
        </div>
    </div>
