<section class="container py-5">
    <div class="page-head-row mb-4">
        <div>
            <h2 class="mb-1">Coming up next</h2>
            <p class="text-muted mb-0">Entries are open for these events. Create a free account to enter.</p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Events" asp-action="Index">See all events</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty">
            <div class="icon"><i class="bi bi-calendar-plus"></i></div>
            <h3>No events are open for entries yet</h3>
            <p>Organisers can publish the first one in a few minutes.</p>
            <a class="btn btn-primary" asp-controller="Account" asp-action="Register" asp-route-role="Organiser">Create an organiser account</a>
        </div>
    }
    else
    {
        <div class="event-grid">
            @foreach (var item in Model)
            {
                <partial name="_EventCard" model="item" />
            }
        </div>
    }
</section>

<section class="container pb-5">
    <h2 class="mb-4">Built for both sides of the start line</h2>
    <div class="role-split">
        <div class="role-card">
            <span class="type-tag mb-3"><i class="bi bi-person-walking"></i>Participants</span>
            <h3>Enter, train, finish</h3>
            <ul>
                <li>Search events by type, town and date</li>
                <li>Enter in your age or distance category</li>
                <li>Track entry status from pending to confirmed</li>
                <li>Keep your finish times and positions in one race history</li>
            </ul>
            <a class="btn btn-primary" asp-controller="Account" asp-action="Register" asp-route-role="Participant">Join as a participant</a>
        </div>
        <div class="role-card">
            <span class="type-tag mb-3"><i class="bi bi-flag"></i>Organisers</span>
            <h3>Run race control from one screen</h3>
            <ul>
                <li>Publish events with banner images</li>
                <li>Set up age groups and distance categories</li>
                <li>Confirm entries and see numbers per event</li>
                <li>Capture and publish results after race day</li>
            </ul>
            <a class="btn btn-dark" asp-controller="Account" asp-action="Register" asp-route-role="Organiser">Join as an organiser</a>
        </div>
    </div>
</section>
