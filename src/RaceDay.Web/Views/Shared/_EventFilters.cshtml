@model EventFilterViewModel
@{
    // The form posts back (GET) to whichever page rendered it, so it works on the public list and the Participant dashboard.
    var action = ViewData["FilterAction"] as string ?? Context.Request.Path;
}
<form method="get" action="@action" class="filter-bar" role="search" aria-label="Filter events">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-8 col-xl-4">
            <label class="form-label" for="Search">Search</label>
            <input class="form-control" id="Search" name="Search" value="@Model.Search" placeholder="Event name, place or description" maxlength="100" />
        </div>
        <div class="col-12 col-md-4 col-xl-2">
            <label class="form-label" for="EventType">Type</label>
            <select class="form-select" id="EventType" name="EventType">
                <option value="">Any type</option>
                @foreach (var type in new[] { "Run", "Walk", "Cycle" })
                {
                    <option value="@type" selected="@(Model.EventType == type)">@type</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-4 col-xl-2">
            <label class="form-label" for="Location">Location</label>
            <input class="form-control" id="Location" name="Location" value="@Model.Location" placeholder="e.g. Durban" maxlength="100" />
        </div>
        <div class="col-6 col-md-3 col-xl-1-5">
            <label class="form-label" for="From">From</label>
            <input class="form-control px-2" type="date" id="From" name="From" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-3 col-xl-1-5">
            <label class="form-label" for="To">To</label>
            <input class="form-control px-2" type="date" id="To" name="To" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-md-2 col-xl-1 d-flex gap-2 flex-xl-column">
            <button type="submit" class="btn btn-primary flex-grow-1" data-no-busy><i class="bi bi-search me-1"></i>Filter</button>
            @if (Model.HasFilters)
            {
                <a class="btn btn-outline-primary" href="@action" title="Clear filters">Clear</a>
            }
        </div>
    </div>
</form>
